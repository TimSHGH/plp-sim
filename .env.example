# Copy to .env and fill in. .env is gitignored and must never be committed.

OPENAI_API_KEY=sk-your-key-here

# The cutoff. Everything a persona is told comes from before this date;
# everything it is scored on happened after. Changing it invalidates the
# separation the whole study rests on.
CUTOFF_DATE=2026-04-01

MODEL=gpt-4o-mini

# Whether to include ex-Labour independents in the population. Off by default:
# they are the most behaviourally extreme cases on exactly the question being
# asked, so their exclusion is a modelling choice worth stating rather than
# hiding in a filter.
INCLUDE_DEFECTORS=false
